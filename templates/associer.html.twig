{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
    <h1>Bienvenue, {{ user.nom }} {{ user.prenom }}!</h1>
    <h2>Voici votre panier actuel:</h2>

    {% if panier %}
        <p>Votre panier contient {{ panier.quantite }} produit(s).</p>
        <p>Prix total : {{ panier.prixTotale }}€</p>
    {% else %}
        <p>Votre panier est vide.</p>
    {% endif %}

    <a href="{{ path('valider_commande') }}">Valider la commande</a>
{% endblock %}
