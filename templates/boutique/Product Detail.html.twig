<script>
document.addEventListener("DOMContentLoaded", function () {
    // Sélectionnez tous les boutons d'ajout au panier
    document.querySelectorAll(".js-addcart-detail").forEach(function (button) {
        button.addEventListener("click", function (e) {
            e.preventDefault();

            // Désactivez temporairement le bouton pour éviter plusieurs clics
            button.disabled = true;

            // Récupérez l'ID du produit depuis l'attribut 'data-product-id'
            const productId = this.getAttribute("data-product-id");

            // Récupérez la quantité associée (si elle existe, sinon elle est définie à 1)
            const quantityInput = document.querySelector(`.quantity-input[data-product-id="${productId}"]`);
            const quantity = quantityInput ? parseInt(quantityInput.value) : 1;

            // Vérifiez si la quantité est valide
            if (isNaN(quantity) || quantity < 1) {
                alert("Quantité invalide !");
                button.disabled = false; // Réactivez le bouton en cas d'erreur
                return;
            }

            // Envoie une requête AJAX pour ajouter au panier
            fetch(`/panier/ajouter/${productId}`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({ quantite: quantity })
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error("Erreur réseau lors de l'ajout au panier.");
                }
                return response.json();  // Convertir la réponse en JSON
            })
            .then(data => {
                if (data.success) {
                    alert("Produit ajouté au panier avec succès !");
                    
                    // Mise à jour dynamique de l'interface utilisateur si nécessaire
                    const stockElement = document.querySelector(`.product-stock[data-product-id="${productId}"]`);
                    if (stockElement) {
                        stockElement.textContent = `Stock restant : ${data.produit.stockRestant}`;
                    }

                    // Mise à jour dynamique du panier après ajout
                    updateCartDisplay();
					
                } else {
                    alert("Erreur : " + data.message);
                }
            })
            .catch(error => {
                console.error("Erreur:", error);
                alert("Une erreur est survenue lors de l'ajout au panier.");
            })
            .finally(() => {
                button.disabled = false; // Réactivez le bouton après l'opération
            });
        });
    });
});

