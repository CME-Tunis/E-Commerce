<script>
document.addEventListener("DOMContentLoaded", function() {
    const accountIcon = document.getElementById("account-icon");
    const dropdownMenu = document.getElementById("dropdown-menu");

    // Lorsque l'icône de compte est cliquée, afficher/masquer le menu
    accountIcon.addEventListener("click", function(e) {
        e.preventDefault(); // Empêcher l'action par défaut du lien
        dropdownMenu.style.display = dropdownMenu.style.display === "block" ? "none" : "block";
    });

    // Fermer le menu si l'utilisateur clique en dehors de l'icône ou du menu
    document.addEventListener("click", function(e) {
        if (!accountIcon.contains(e.target) && !dropdownMenu.contains(e.target)) {
            dropdownMenu.style.display = "none";
        }
    });
});

</script>
