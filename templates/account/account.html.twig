	<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Sélectionne tous les boutons "Ajouter au panier"
        var addToCartButtons = document.querySelectorAll('.add-to-cart');

        // Parcourt tous les boutons
        addToCartButtons.forEach(function(button) {
            button.addEventListener('click', function(event) {
                event.preventDefault();

                // Sélectionne le panneau du panier
                var panelCart = document.querySelector('.js-panel-cart');

                // Vérifie s'il existe
                if (panelCart) {
                    // Ajoute la classe qui affiche le panneau
                    panelCart.classList.add('show-header-cart');
                }
            });
        });
    });
</script>

	<script>
document.querySelectorAll('.add-to-cart').forEach(button => {
    button.addEventListener('click', event => {
        event.preventDefault();
        const productId = event.currentTarget.getAttribute('data-product-id');
        
        fetch(`/boutique/add/${productId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Mise à jour du panier
                updateCartDisplay();

                // Affichage du panneau du panier
                const cartPanel = document.querySelector('.js-panel-cart');
                cartPanel.classList.add('show-cart');
                // Mise à jour de la quantité dans l'icône du panier

				 const cartIcon = document.querySelector('.icon-header-noti');
                    if (cartIcon) {
                        cartIcon.setAttribute('data-notify', data.quantiteTotale);
                    }
            } else {
                alert('Erreur lors de l\'ajout au panier');
            }
        })
        .catch(error => console.error('Erreur:', error));
    });
});

// Fonction pour mettre à jour l'affichage du panier
function updateCartDisplay() {
    fetch('/boutique/cart-contents')  // URL pour obtenir le contenu du panier
        .then(response => response.json())
        .then(data => {
            const cartContainer = document.querySelector('.header-cart-wrapitem');
            const totalPriceElement = document.querySelector('#somme-totale');
			 const cartIcon = document.querySelector('.icon-header-noti');
 if (cartIcon) {
                cartIcon.setAttribute('data-notify', data.quantiteTotale);
            }
            // Vider l'ancien contenu du panier
            cartContainer.innerHTML = '';

            // Réinsérer les produits mis à jour
            data.paniers.forEach(panier => {
                const productHTML = `
                    <li class="header-cart-item flex-w flex-t m-b-12" style="display: flex; align-items: center; gap: 15px;">
                        <!-- Image du produit -->
                        <div class="header-cart-item-img">
                            <img src="/produit/${panier.panierProd.image}" alt="IMG" style="width: 60px; height: 60px; object-fit: cover;">
                        </div>

                        <!-- Contenu du produit -->
                        <div style="display: flex; flex-direction: column; gap: 5px;">
                            <!-- Nom du produit -->
                            <a href="#" class="header-cart-item-name hov-cl1 trans-04" style="font-weight: bold;">
                                ${panier.panierProd.nomP}
                            </a>

                         

							<div style="display: flex; flex-direction: column; gap: 5px;">
                            <!-- Quantité -->
                            <div class="flex-w" style="display: flex; align-items: center; gap: 5px;">
                                <div 
                                    class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m" 
                                    data-panier-id="${ panier.id }" 
                                    style="width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; background: #f1f1f1; border-radius: 5px;">
                                    <i class="fs-16 zmdi zmdi-minus"></i>
                                </div>

                                <input 
                                    class="mtext-104 cl3 txt-center num-product" 
                                    type="number" 
                                    name="num-product1" 
                                    value="${ panier.quantite }" 
                                    min="0" 
                                    data-panier-id="${panier.id}"
                                    style="width: 40px; text-align: center; border: 1px solid #ccc;"/>

                                <div 
                                    class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m" 
                                    data-panier-id="${panier.id}" 
                                    style="width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; background: #f1f1f1; border-radius: 5px;">
                                    <i class="fs-16 zmdi zmdi-plus"></i>
                                </div>
                            </div>

                            <!-- Prix total sous la quantité -->
                            <span class="header-cart-item-info" style="font-weight: bold;" data-panier-id="${panier.id}">
                                ${panier.prixTotale} TND
                            </span>
                        </div>
                        </div>
                    </li>
                `;
                cartContainer.insertAdjacentHTML('beforeend', productHTML);
            });

            // Mettre à jour le prix total
            totalPriceElement.textContent = `${parseFloat(data.sommeTotale).toFixed(3)} TND`;

            // Ajouter les événements pour l'incrémentation et la décrémentation
            addCartEventListeners();
        })
        .catch(error => console.error('Erreur lors de la mise à jour du panier:', error));
}

// Fonction pour ajouter les événements aux boutons
function addCartEventListeners() {
    document.querySelectorAll('.btn-num-product-up, .btn-num-product-down').forEach(element => {
        element.addEventListener('click', (event) => {
            const panierId = event.currentTarget.getAttribute('data-panier-id');
            const isIncrement = event.currentTarget.classList.contains('btn-num-product-up');

            const quantityInputs = document.querySelectorAll(`input[data-panier-id="${panierId}"]`);
            const totalPriceCells = document.querySelectorAll(`.header-cart-item-info[data-panier-id="${panierId}"]`);

            if (!quantityInputs.length || !totalPriceCells.length) {
                console.error(`Élément introuvable pour l'ID du panier : ${panierId}`);
                return;
            }

            let currentQuantity = parseInt(quantityInputs[0].value, 10);
            let newQuantity = isIncrement ? currentQuantity + 1 : currentQuantity - 1;

            if (newQuantity < 1) {
                deleteProduct(panierId);
            } else {
                updateCart(panierId, newQuantity, quantityInputs, totalPriceCells);
            }
        });
    });

    document.querySelectorAll('.num-product').forEach(input => {
        input.addEventListener('input', (event) => {
            const panierId = event.currentTarget.getAttribute('data-panier-id');
            const totalPriceCells = document.querySelectorAll(`.header-cart-item-info[data-panier-id="${panierId}"]`);

            let newQuantity = parseInt(event.currentTarget.value, 10);

            if (isNaN(newQuantity) || newQuantity < 1) {
                deleteProduct(panierId);
            } else {
                updateCart(panierId, newQuantity, document.querySelectorAll(`input[data-panier-id="${panierId}"]`), totalPriceCells);
            }
        });
    });
}

function updateCart(panierId, newQuantity, quantityInputs, totalPriceCells) {
    fetch(`/boutique/update/${panierId}`, { 
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ quantite: newQuantity }),
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            quantityInputs.forEach(input => input.value = newQuantity);
            totalPriceCells.forEach(cell => cell.textContent = `${parseFloat(data.newTotalPrice).toFixed(3)} TND`);

            document.querySelectorAll("#somme-totale, .mtext-110").forEach(el => {
                el.textContent = `${parseFloat(data.sommeTotale).toFixed(3)} TND`;
            });
        } else {
            alert(data.message || 'Erreur lors de la mise à jour.');
        }
    })
    .catch(error => console.error('Erreur :', error));
}

function deleteProduct(panierId) {
    fetch(`/boutique/remove/${panierId}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            updateCartDisplay(); 
        } else {
            alert(data.message || 'Erreur lors de la suppression.');
        }
    })
    .catch(error => console.error('Erreur :', error));
}

</script>
	


